# Copia este fichero a .env antes de levantar docker compose.

# Clave para firmar los JWT. Genera una con: openssl rand -hex 32
SECRET_KEY=

# Credenciales del entrenador que se crean en el primer arranque.
COACH_USERNAME=entrenador
COACH_PASSWORD=
COACH_NAME=Entrenador

# Puerto en el que se publica la app.
APP_PORT=8080

# Orígenes permitidos por CORS. Añade aquí la URL real desde la que se accede.
CORS_ORIGINS=http://localhost:8080

# Duración de la sesion en minutos (720 = 12 h).
ACCESS_TOKEN_EXPIRE_MINUTES=720
