# Clave para firmar los JWT. CAMBIALA en produccion.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# Minutos de validez del token de sesion
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Ruta de la base de datos SQLite
DATABASE_URL=sqlite:////data/cargas.db
# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Credenciales del entrenador que se crea al arrancar por primera vez
COACH_USERNAME=entrenador
COACH_PASSWORD=cambiame
COACH_NAME=Entrenador
